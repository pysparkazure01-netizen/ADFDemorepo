SELECT
    COUNT(DISTINCT C.DIM_CUST_CURR_ID)  AS TOTAL_BLEND_IDS,
    
    COUNT(DISTINCT CB.CUST_CURR_ID)     AS COMPILE_BRIDGE_MATCHES,
    COUNT(DISTINCT DB.CUST_CURR_ID)     AS DEFINITIVE_BRIDGE_MATCHES,
    
    -- How many match NEITHER bridge
    COUNT(DISTINCT CASE 
        WHEN CB.CUST_CURR_ID IS NULL 
        AND DB.CUST_CURR_ID IS NULL 
        THEN C.DIM_CUST_CURR_ID END)    AS NO_BRIDGE_MATCH,
        
    -- How many have SPCLTY_DSC as last resort fallback    
    COUNT(DISTINCT CASE 
        WHEN C.SPCLTY_DSC IS NOT NULL 
        THEN C.DIM_CUST_CURR_ID END)    AS HAS_SPCLTY_DSC

FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.V_DIM_CUST_E1_BLEND_CURR C
LEFT JOIN DEV_ENT_DL_US_BUS_DB.CSS_CUSTOMER_DATA_MODEL.V_MMS_CUSTOMER_BRIDGE_TO_COMPILE CB 
    ON C.DIM_CUST_CURR_ID = CB.CUST_CURR_ID
LEFT JOIN DEV_ENT_DL_US_BUS_DB.CSS_CUSTOMER_DATA_MODEL.MMS_CUSTOMER_BRIDGE_TO_DEFINITIVE DB 
    ON C.DIM_CUST_CURR_ID = DB.CUST_CURR_ID
WHERE C.PTNT_FLG <> 'Y'
  AND C.SYS_PLTFRM = 'E1';

  -------steps 2 
  -- See if SPCLTY_DSC from blend table matches anything in lookup
SELECT
    C.SPCLTY_DSC,
    LYL.CUST_SGMNT_DFLT_TYPE_DSC,
    LYL.LOYAL_CTGRY_LIMIT,
    COUNT(DISTINCT C.DIM_CUST_CURR_ID) AS CUST_COUNT
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.V_DIM_CUST_E1_BLEND_CURR C
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.CHURN_SITE_LOYAL_CTGRY_CW LYL
    ON UPPER(C.SPCLTY_DSC) = UPPER(LYL.CUST_SGMNT_DFLT_TYPE_DSC)
WHERE C.PTNT_FLG <> 'Y'
  AND C.SYS_PLTFRM = 'E1'
GROUP BY 1,2,3
ORDER BY CUST_COUNT DESC
LIMIT 50;
----step 3
-- Find customers in blend table that have NO row in view at all
SELECT
    C.DIM_CUST_CURR_ID,
    C.SPCLTY_DSC,
    C.MMS_CLASS_DSC,
    C.MMS_SUB_CLASS_DSC,
    CB.CUST_CURR_ID     AS COMPILE_ID,
    DB.CUST_CURR_ID     AS DEFINITIVE_ID
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.V_DIM_CUST_E1_BLEND_CURR C
-- Check if they exist in view
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT_SK4112026 SR
    ON C.DIM_CUST_CURR_ID = SR.DIM_CUST_CURR_ID
-- Check bridge tables
LEFT JOIN DEV_ENT_DL_US_BUS_DB.CSS_CUSTOMER_DATA_MODEL.V_MMS_CUSTOMER_BRIDGE_TO_COMPILE CB 
    ON C.DIM_CUST_CURR_ID = CB.CUST_CURR_ID
LEFT JOIN DEV_ENT_DL_US_BUS_DB.CSS_CUSTOMER_DATA_MODEL.MMS_CUSTOMER_BRIDGE_TO_DEFINITIVE DB 
    ON C.DIM_CUST_CURR_ID = DB.CUST_CURR_ID
WHERE C.PTNT_FLG <> 'Y'
  AND C.SYS_PLTFRM = 'E1'
  AND SR.DIM_CUST_CURR_ID IS NULL  -- not in view
LIMIT 100;


