import sys, subprocess, getpass, importlib.util
print("Python :", sys.version.split()[0], "|", sys.executable)
print("OS user:", getpass.getuser())
for m in ["paramiko", "azure.storage.blob", "azure.identity"]:
    try:
        ok = importlib.util.find_spec(m) is not None
    except ModuleNotFoundError:
        ok = False
    print(f"{m:20s}: {'INSTALLED' if ok else 'MISSING'}")
r = subprocess.run([sys.executable, "-m", "pip", "--version"],
                   capture_output=True, text=True)
print("pip    :", (r.stdout or r.stderr).strip())
