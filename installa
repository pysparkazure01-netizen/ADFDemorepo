from azure.identity import ManagedIdentityCredential
from azure.storage.blob import BlobServiceClient
svc = BlobServiceClient("https://sadsprodmigrationwest.blob.core.windows.net",
                        credential=ManagedIdentityCredential())
c = svc.get_container_client("dev-dl")
try:
    c.upload_blob("inbound/dscsa_ib_mba/_write_test.txt", b"test", overwrite=True)
    print("WRITE OK")
except Exception as e:
    print("WRITE FAILED ->", str(e).splitlines()[0])
