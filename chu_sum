AND CI.CUST_E1_NUM = EC_TIER.CUST_E1_NUM
AND CI.BUS_PLTFRM = EC_TIER.BUS_PLTFRM
WHERE CI.MONTH_RUN > 201712
AND CI.LGCY_PLTFRM = 'MMS'
AND CI.CHURN_FLAG <> 'UNKNOWN'
AND PFT.ROLL_YR_FLAG = 'PY'
GROUP BY
      CI.BILL_TO_CUST_E1_NUM, CI.CUST_E1_NUM, CI.LGCY_PLTFRM, CI.SYS_PLTFRM, CI.BUS_PLTFRM,
      CNVRSN.CNVRSN_TYPE_CD, CNVRSN.CNVRSN_TYPE_DSC, EC_TIER.TIER_CD, EC_TIER.TIER_DSC,
