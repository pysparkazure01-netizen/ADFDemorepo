"""
blob_archive_prod.py
--------------------
Move loaded files in Azure Blob from the main folder to its Archive sub-folder,
e.g.  dev-dl/inbound/dscsa_mba/<file>  ->  dev-dl/inbound/dscsa_mba/Archive/<file>_<YYYYMMDDHHMMSS>

Run it in a Matillion "Python Script" component (Interpreter = Python 3,
Timeout = 3600), AFTER the Snowflake Copy Command has succeeded.

  * Only files directly in the main folder are moved (sub-folders such as
    Archive/ are never touched)
  * Move = server-side copy inside the storage account, wait until the copy
    has finished, check the size, then delete the original. Nothing is
    deleted unless its archive copy is confirmed.
  * Parallel (thread pool) - thousands of files in a few minutes
  * Optional cutoff: only files that landed before a given UTC time are moved,
    so a file that arrives while the COPY is running is not archived unloaded
  * DRY_RUN = True lists what would move without changing anything
  * Same login and Matillion variables as sftp_to_blob_prod.py; no secrets in code
"""

# ==========================================================================
# CONFIG - DEV values shown; per-environment values come from the Matillion
# variables in VARIABLE_OVERRIDES when they exist.
# ==========================================================================
CONFIG = {
    "dry_run":         True,    # True = only list; set False to really move

    # ---- Blob ----
    "storage_account": "<STORAGE_ACCOUNT>",      # DEV: sadsprodmigrationwest
    "container":       "<CONTAINER>",            # DEV: dev-dl
    "source_prefix":   "inbound/dscsa_mba",      # main folder (no leading/trailing "/")
    "archive_folder":  "Archive",                # sub-folder under source_prefix
    "name_suffix":     "timestamp",              # "timestamp" -> <name>_YYYYMMDDHHMMSS
                                                 # None        -> keep the same name
    # files to move: .xml, no extension, Tracelink 919110XML... names
    "pattern":         r"(?i)^(?:.*\.xml|[^.]+|\d+XML\d+\..+)$",
    "cutoff_utc":      None,    # e.g. "2026-11-09T17:30:00" - only move files
                                # last modified BEFORE this UTC time; None = all
    "max_files":       None,    # cap per run; None = all
    "workers":         16,

    # ---- Login (service principal, same app as Matillion's "blob" credential) ----
    "blob_auth":       "service_principal",      # or "connection_string"
    "tenant_id":       "da67ef1b-ca59-4db2-9a8c-aa8d94617a16",
    "client_id":       "<CLIENT_ID>",            # DEV: 9681266b-e1a1-4256-b4f3-199b27f42738
    "client_secret_var": ["jv_azure_client_secret", "ev_dscsa_azure_client_secret"],
    "blob_conn_str":   None,                     # only for "connection_string"
}

VARIABLE_OVERRIDES = {
    "dry_run":         ["jv_archive_dry_run"],
    "storage_account": ["ev_dscsa_storage_account"],
    "container":       ["ev_dscsa_blob_container"],
    "client_id":       ["ev_dscsa_client_id"],
    "tenant_id":       ["ev_dscsa_tenant_id"],
    "source_prefix":   ["jv_archive_source_prefix", "jv_blob_prefix", "ev_dscsa_blob_prefix"],
    "cutoff_utc":      ["jv_archive_cutoff_utc"],
    "max_files":       ["jv_archive_max_files"],
    "workers":         ["jv_archive_workers"],
}

RESULT_VARIABLES = {
    "matched": "jv_archive_files_matched",
    "moved":   "jv_archive_files_moved",
    "failed":  "jv_archive_files_failed",
}
# ==========================================================================

import posixpath
import re
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone

from azure.storage.blob import BlobServiceClient


def _is_placeholder(v):
    return v is None or (isinstance(v, str) and (v.strip() == "" or v.startswith("<")))


def apply_overrides(cfg, g):
    used = []
    for key, names in VARIABLE_OVERRIDES.items():
        for var in names:
            val = g.get(var)
            if _is_placeholder(val):
                continue
            val = str(val).strip()
            if key in ("workers",):
                val = int(val)
            elif key == "max_files":
                val = int(val) or None
            elif key == "dry_run":
                val = val.lower() in ("true", "yes", "y", "1")
            elif val.lower() == "none":
                val = None
            cfg[key] = val
            used.append(f"{key}<-{var}")
            break
    print("Values from Matillion variables:", ", ".join(used) if used else "none")


def container_client(cfg, g):
    if cfg["blob_auth"] == "connection_string":
        svc = BlobServiceClient.from_connection_string(cfg["blob_conn_str"])
    else:
        from azure.identity import ClientSecretCredential
        names = cfg["client_secret_var"]
        secret = next((g.get(n) for n in names if not _is_placeholder(g.get(n))), None)
        if _is_placeholder(secret):
            raise ValueError("Azure client secret: none of the Matillion variables "
                             + ", ".join(names) + " is set")
        cred = ClientSecretCredential(cfg["tenant_id"], cfg["client_id"], secret)
        svc = BlobServiceClient(f"https://{cfg['storage_account']}.blob.core.windows.net",
                                credential=cred)
    return svc.get_container_client(cfg["container"])


def list_candidates(container, cfg):
    prefix = cfg["source_prefix"].strip("/") + "/"
    rx = re.compile(cfg["pattern"])
    cutoff = None
    if cfg.get("cutoff_utc"):
        cutoff = datetime.fromisoformat(str(cfg["cutoff_utc"]).replace("Z", "")) \
            .replace(tzinfo=timezone.utc)
    out, skipped_new = [], 0
    # walk_blobs with delimiter -> only files directly in the folder, not Archive/...
    for item in container.walk_blobs(name_starts_with=prefix, delimiter="/"):
        name = item.name
        if name.endswith("/"):            # a sub-folder (e.g. Archive/) - skip
            continue
        base = name[len(prefix):]
        if not base or not rx.match(base) or base.startswith("_write_probe_"):
            continue
        if cutoff and item.last_modified and item.last_modified >= cutoff:
            skipped_new += 1
            continue
        out.append((name, item.size))
        if cfg.get("max_files") and len(out) >= cfg["max_files"]:
            break
    if skipped_new:
        print(f"  skipped {skipped_new} file(s) that arrived after the cutoff")
    return out


def move_one(container, name, size, cfg, stamp, retries=3):
    prefix = cfg["source_prefix"].strip("/")
    base = posixpath.basename(name)
    target_name = base + (f"_{stamp}" if cfg.get("name_suffix") == "timestamp" else "")
    target = f"{prefix}/{cfg['archive_folder']}/{target_name}"
    last = None
    for attempt in range(1, retries + 1):
        try:
            src = container.get_blob_client(name)
            dst = container.get_blob_client(target)
            dst.start_copy_from_url(src.url)
            for _ in range(120):                       # wait up to ~60 s
                props = dst.get_blob_properties()
                status = props.copy.status
                if status != "pending":
                    break
                time.sleep(0.5)
            if status != "success":
                raise RuntimeError(f"copy status {status}")
            if props.size != size:
                raise RuntimeError(f"size mismatch {props.size} != {size}")
            src.delete_blob()
            return {"file": name, "target": target, "status": "MOVED", "error": ""}
        except Exception as e:
            last = e
            if "BlobNotFound" in str(e):              # already moved by someone else
                return {"file": name, "target": target, "status": "GONE",
                        "error": "source no longer exists"}
            time.sleep(2 * attempt)
    return {"file": name, "target": target, "status": "FAILED",
            "error": str(last).splitlines()[0]}


def run(cfg, g):
    t0 = time.time()
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    container = container_client(cfg, g)
    files = list_candidates(container, cfg)
    print(f"{len(files)} file(s) to archive in {cfg['container']}/{cfg['source_prefix']}/ "
          f"-> {cfg['archive_folder']}/   (dry_run={cfg['dry_run']})")
    for name, _ in files[:5]:
        print("   ", name)
    if cfg["dry_run"]:
        print("DRY RUN - nothing moved. Set dry_run False (or jv_archive_dry_run = No) to move.")
        return {"matched": len(files), "moved": 0, "failed": 0}

    results = []
    with ThreadPoolExecutor(max_workers=int(cfg["workers"])) as ex:
        futs = [ex.submit(move_one, container, n, s, cfg, stamp) for n, s in files]
        for i, f in enumerate(as_completed(futs), 1):
            results.append(f.result())
            if i % 500 == 0 or i == len(futs):
                print(f"  progress {i}/{len(futs)}")
    moved = sum(r["status"] == "MOVED" for r in results)
    gone = sum(r["status"] == "GONE" for r in results)
    failed = [r for r in results if r["status"] == "FAILED"]
    print(f"Done in {time.time() - t0:.1f}s  MOVED={moved}  GONE={gone}  FAILED={len(failed)}")
    for r in failed[:20]:
        print(f"  FAILED {r['file']}: {r['error']}")
    summary = {"matched": len(files), "moved": moved, "failed": len(failed)}
    if failed:
        raise RuntimeError(f"{len(failed)} file(s) could not be archived (originals kept)")
    return summary


def publish(summary, g):
    ctx = g.get("context")
    if ctx is None:
        return
    for k, var in RESULT_VARIABLES.items():
        try:
            ctx.updateVariable(var, str(summary[k]))
        except Exception:
            pass


_g = globals()
apply_overrides(CONFIG, _g)
_missing = [k for k in ("storage_account", "container", "source_prefix")
            if _is_placeholder(CONFIG.get(k))]
if CONFIG["blob_auth"] == "service_principal":
    _missing += [k for k in ("tenant_id", "client_id") if _is_placeholder(CONFIG.get(k))]
if _missing:
    raise ValueError("Fill in CONFIG / Matillion variables first: " + ", ".join(_missing))
_summary = run(CONFIG, _g)
print(_summary)
publish(_summary, _g)
