-- SIDE BY SIDE: Old MDM values vs New View values vs Lookup table
SELECT
    -- Match status summary
    CASE 
        WHEN LYL_OLD.LOYAL_CTGRY_LIMIT IS NOT NULL 
         AND LYL_NEW.LOYAL_CTGRY_LIMIT IS NULL 
        THEN 'BROKEN - Was working, now failing'
        WHEN LYL_OLD.LOYAL_CTGRY_LIMIT IS NULL 
         AND LYL_NEW.LOYAL_CTGRY_LIMIT IS NULL 
        THEN 'Both failing'
        WHEN LYL_OLD.LOYAL_CTGRY_LIMIT IS NOT NULL 
         AND LYL_NEW.LOYAL_CTGRY_LIMIT IS NOT NULL 
        THEN 'Both working'
        WHEN LYL_OLD.LOYAL_CTGRY_LIMIT IS NULL 
         AND LYL_NEW.LOYAL_CTGRY_LIMIT IS NOT NULL 
        THEN 'New works, Old didnt'
        ELSE 'Other'
    END AS MATCH_STATUS,

    -- OLD MDM segment values (from MDM_GR_CNSL_ALL directly)
    GRC.CUST_SGMNT_MKT_DSC        AS OLD_MAPS_MKT,
    GRC.CUST_SGMNT_SETTNG_DSC     AS OLD_MAPS_STNG,
    GRC.CUST_SGMNT_DFLT_TYPE_DSC  AS OLD_MAPS_TYPE,

    -- NEW VIEW segment values
    SR.MAPS_MKT                   AS NEW_MAPS_MKT,
    SR.MAPS_STNG                  AS NEW_MAPS_STNG,
    SR.MAPS_TYPE                  AS NEW_MAPS_TYPE,

    -- Lookup results
    LYL_OLD.LOYAL_CTGRY_LIMIT     AS OLD_LOYAL_LIMIT,
    LYL_NEW.LOYAL_CTGRY_LIMIT     AS NEW_LOYAL_LIMIT,

    COUNT(*)                       AS CUST_COUNT

FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.V_DIM_CUST_E1_BLEND_CURR CB

-- NEW VIEW
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT SR
    ON CB.DIM_CUST_CURR_ID = SR.DIM_CUST_CURR_ID

-- OLD MDM chain
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.MDM_GR_SOURCE_REL MDM_SR
    ON CB.CUST_E1_NUM = MDM_SR.SRC_REC_ID
    AND MDM_SR.REC_STATUS_DSC = 'Active'
    AND MDM_SR.SRC_SYS_CD = 'JDE'
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.MDM_GR_CNSL_ALL GRC
    ON MDM_SR.MDM_PARTY_ID = GRC.MDM_PARTY_ID
    AND GRC.REC_STATUS_DSC = 'Active'

-- Lookup using OLD MDM values
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.CHURN_SITE_LOYAL_CTGRY_CW LYL_OLD
    ON GRC.CUST_SGMNT_MKT_DSC       = LYL_OLD.CUST_SGMNT_MKT_DSC
    AND GRC.CUST_SGMNT_SETTNG_DSC    = LYL_OLD.CUST_SGMNT_SETTNG_DSC
    AND GRC.CUST_SGMNT_DFLT_TYPE_DSC = LYL_OLD.CUST_SGMNT_DFLT_TYPE_DSC

-- Lookup using NEW VIEW values
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.CHURN_SITE_LOYAL_CTGRY_CW LYL_NEW
    ON SR.MAPS_MKT   = LYL_NEW.CUST_SGMNT_MKT_DSC
    AND SR.MAPS_STNG  = LYL_NEW.CUST_SGMNT_SETTNG_DSC
    AND SR.MAPS_TYPE  = LYL_NEW.CUST_SGMNT_DFLT_TYPE_DSC

GROUP BY 1,2,3,4,5,6,7,8,9
ORDER BY CUST_COUNT DESC;
