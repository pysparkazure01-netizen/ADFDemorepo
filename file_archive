"""
blob_archive_prod.py
--------------------
Move loaded files in Azure Blob from the main folder to its Archive sub-folder:
    <container>/<folder>/<file>  ->  <container>/<folder>/Archive/<file>_<YYYYMMDDHHMMSS>

Run in a Matillion "Python Script" component (Interpreter = Python 3,
Timeout = 3600), connected to the SUCCESS output of the Snowflake Copy Command.

  * Only files directly in the main folder are moved; sub-folders such as
    Archive/ are never touched
  * Move = server-side copy inside the storage account -> wait for the copy ->
    check the size -> delete the original. Nothing is deleted unless its
    archive copy is confirmed.
  * Parallel (thread pool)
  * All settings and the secret come from Matillion variables; nothing
    environment-specific is stored in this script

MATILLION VARIABLES
  Required (environment variables, one value per environment):
    ev_dscsa_storage_account       storage account name
    ev_dscsa_blob_container        container
    ev_dscsa_tenant_id             Azure tenant ID
    ev_dscsa_client_id             service principal client (application) ID
    ev_dscsa_azure_client_secret   service principal secret
  Required (job variable, or one of its fallbacks):
    jv_archive_source_prefix       main Blob folder, e.g. inbound/dscsa_mba
                                   (falls back to jv_blob_prefix, ev_dscsa_blob_prefix)
  Optional (job variables):
    jv_archive_dry_run             Yes = only list, move nothing (default No)
    jv_archive_cutoff_utc          only move files last modified before this
                                   UTC time, e.g. 2026-11-09T17:30:00
    jv_archive_max_files           cap per run (0 = no cap)
    jv_archive_workers             parallel threads (default 16)
  Written back after the run (if they exist as job variables):
    jv_archive_files_matched, jv_archive_files_moved, jv_archive_files_failed
"""

# ==========================================================================
# Defaults (not environment-specific)
# ==========================================================================
CONFIG = {
    "dry_run":        False,
    "archive_folder": "Archive",       # sub-folder under the main folder
    "name_suffix":    "timestamp",     # "timestamp" -> <name>_YYYYMMDDHHMMSS ; None -> same name
    # files to move: .xml, no extension, Tracelink 919110XML... names
    "pattern":        r"(?i)^(?:.*\.xml|[^.]+|\d+XML\d+\..+)$",
    "cutoff_utc":     None,
    "max_files":      None,
    "workers":        16,
}

# CONFIG key -> Matillion variable names, first non-empty one wins
VARIABLE_OVERRIDES = {
    "storage_account": ["ev_dscsa_storage_account"],
    "container":       ["ev_dscsa_blob_container"],
    "tenant_id":       ["ev_dscsa_tenant_id"],
    "client_id":       ["ev_dscsa_client_id"],
    "client_secret":   ["jv_azure_client_secret", "ev_dscsa_azure_client_secret"],
    "source_prefix":   ["jv_archive_source_prefix", "jv_blob_prefix", "ev_dscsa_blob_prefix"],
    "dry_run":         ["jv_archive_dry_run"],
    "cutoff_utc":      ["jv_archive_cutoff_utc"],
    "max_files":       ["jv_archive_max_files"],
    "workers":         ["jv_archive_workers"],
}
REQUIRED = ["storage_account", "container", "tenant_id", "client_id",
            "client_secret", "source_prefix"]
SECRET_KEYS = {"client_secret"}        # never printed

RESULT_VARIABLES = {
    "matched": "jv_archive_files_matched",
    "moved":   "jv_archive_files_moved",
    "failed":  "jv_archive_files_failed",
}
# ==========================================================================

import posixpath
import re
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone

from azure.identity import ClientSecretCredential
from azure.storage.blob import BlobServiceClient


def _is_empty(v):
    return v is None or (isinstance(v, str) and v.strip() == "")


def load_settings(cfg, g):
    used = []
    for key, names in VARIABLE_OVERRIDES.items():
        for var in names:
            val = g.get(var)
            if _is_empty(val):
                continue
            val = str(val).strip().strip('"').strip("'")   # tolerate quotes typed in the grid
            if key == "workers":
                val = int(val)
            elif key == "max_files":
                val = int(val) or None
            elif key == "dry_run":
                val = val.lower() in ("true", "yes", "y", "1")
            elif key != "client_secret" and val.lower() == "none":
                val = None
            cfg[key] = val
            used.append(f"{key}<-{var}")
            break
    print("Values from Matillion variables:", ", ".join(used) if used else "none")
    missing = [k for k in REQUIRED if _is_empty(cfg.get(k))]
    if missing:
        raise ValueError("Missing Matillion variables: " + "; ".join(
            f"{k} (set {' or '.join(VARIABLE_OVERRIDES[k])})" for k in missing))
    print("Settings:", {k: v for k, v in cfg.items()
                        if k not in SECRET_KEYS and k != "pattern"})


def container_client(cfg):
    cred = ClientSecretCredential(cfg["tenant_id"], cfg["client_id"], cfg["client_secret"])
    svc = BlobServiceClient(f"https://{cfg['storage_account']}.blob.core.windows.net",
                            credential=cred)
    return svc.get_container_client(cfg["container"])


def list_candidates(container, cfg):
    prefix = cfg["source_prefix"].strip("/") + "/"
    rx = re.compile(cfg["pattern"])
    cutoff = None
    if cfg.get("cutoff_utc"):
        cutoff = datetime.fromisoformat(str(cfg["cutoff_utc"]).replace("Z", "")) \
            .replace(tzinfo=timezone.utc)
    out, skipped_new = [], 0
    # delimiter "/" -> only files directly in the folder, not Archive/...
    for item in container.walk_blobs(name_starts_with=prefix, delimiter="/"):
        name = item.name
        if name.endswith("/"):                 # a sub-folder (e.g. Archive/)
            continue
        base = name[len(prefix):]
        if not base or not rx.match(base) or base.startswith("_write_probe_"):
            continue
        if cutoff and item.last_modified and item.last_modified >= cutoff:
            skipped_new += 1
            continue
        out.append((name, item.size))
        if cfg.get("max_files") and len(out) >= cfg["max_files"]:
            break
    if skipped_new:
        print(f"  skipped {skipped_new} file(s) that arrived after the cutoff")
    return out


def move_one(container, name, size, cfg, stamp, retries=3):
    prefix = cfg["source_prefix"].strip("/")
    base = posixpath.basename(name)
    target_name = base + (f"_{stamp}" if cfg.get("name_suffix") == "timestamp" else "")
    target = f"{prefix}/{cfg['archive_folder']}/{target_name}"
    last = None
    for attempt in range(1, retries + 1):
        try:
            src = container.get_blob_client(name)
            dst = container.get_blob_client(target)
            dst.start_copy_from_url(src.url)
            for _ in range(120):                       # wait up to ~60 s
                props = dst.get_blob_properties()
                status = props.copy.status
                if status != "pending":
                    break
                time.sleep(0.5)
            if status != "success":
                raise RuntimeError(f"copy status {status}")
            if props.size != size:
                raise RuntimeError(f"size mismatch {props.size} != {size}")
            src.delete_blob()                          # only after a confirmed copy
            return {"file": name, "target": target, "status": "MOVED", "error": ""}
        except Exception as e:
            last = e
            if "BlobNotFound" in str(e):               # already moved by someone else
                return {"file": name, "target": target, "status": "GONE",
                        "error": "source no longer exists"}
            time.sleep(2 * attempt)
    return {"file": name, "target": target, "status": "FAILED",
            "error": str(last).splitlines()[0]}


def run(cfg):
    t0 = time.time()
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    container = container_client(cfg)
    files = list_candidates(container, cfg)
    print(f"{len(files)} file(s) to archive in {cfg['container']}/{cfg['source_prefix']}/ "
          f"-> {cfg['archive_folder']}/   (dry_run={cfg['dry_run']})")
    for name, _ in files[:5]:
        print("   ", name)
    if cfg["dry_run"]:
        print("DRY RUN - nothing moved (jv_archive_dry_run = Yes).")
        return {"matched": len(files), "moved": 0, "failed": 0}

    results = []
    with ThreadPoolExecutor(max_workers=int(cfg["workers"])) as ex:
        futs = [ex.submit(move_one, container, n, s, cfg, stamp) for n, s in files]
        for i, f in enumerate(as_completed(futs), 1):
            results.append(f.result())
            if i % 500 == 0 or i == len(futs):
                print(f"  progress {i}/{len(futs)}")
    moved = sum(r["status"] == "MOVED" for r in results)
    gone = sum(r["status"] == "GONE" for r in results)
    failed = [r for r in results if r["status"] == "FAILED"]
    print(f"Done in {time.time() - t0:.1f}s  MOVED={moved}  GONE={gone}  FAILED={len(failed)}")
    for r in failed[:20]:
        print(f"  FAILED {r['file']}: {r['error']}")
    summary = {"matched": len(files), "moved": moved, "failed": len(failed)}
    if failed:
        raise RuntimeError(f"{len(failed)} file(s) could not be archived (originals kept)")
    return summary


def publish(summary, g):
    ctx = g.get("context")
    if ctx is None:
        return
    for k, var in RESULT_VARIABLES.items():
        try:
            ctx.updateVariable(var, str(summary[k]))
        except Exception:
            pass                               # variable not defined in this job


_g = globals()
load_settings(CONFIG, _g)
_summary = run(CONFIG)
print(_summary)
publish(_summary, _g)
