LIST @DEV_ENT_DL_US_MMS_MISC_DB.DSCSA.DEV_ENT_DL_US_MMS_STG/dscsa_mba/Archive/;

SELECT "name",
       "size",
       TO_TIMESTAMP_NTZ("last_modified", 'DY, DD MON YYYY HH24:MI:SS GMT') AS last_modified_gmt
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
ORDER BY last_modified_gmt DESC
LIMIT 50;

LIST @DEV_ENT_DL_US_MMS_MISC_DB.DSCSA.DEV_ENT_DL_US_MMS_STG/dscsa_mba/Archive/;

SELECT COUNT(*) AS archived_today
FROM TABLE(RESULT_SCAN(LAST_QUERY_ID()))
WHERE TO_TIMESTAMP_NTZ("last_modified", 'DY, DD MON YYYY HH24:MI:SS GMT') >= '2026-11-10';
