CREATE TABLE DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_ST_SUMMARY_CW AS 
SELECT 
      AA.BILL_TO_CUST_E1_NUM,
      AA.CUST_E1_NUM,
      AA.LGCY_PLTFRM, 
      AA.SYS_PLTFRM, 
      AA.BUS_PLTFRM,-- AA.FC_FLAG,
      AA.CNVRSN_TYPE_CD, 
      AA.CNVRSN_TYPE_DSC,
      AA.TIER_CD,
      AA.TIER_DSC,
      AA.PLATFORM,
      AA.MARKET,
      AA.PLAN_MKT_CD, 
      AA.SPCLTY_DSC,
      AA.ROLL_YR_ACCT_STATUS,
      AA.ROLL_YR_END_LIFECYCLE,-- AA.ORDR_SRC_DSC, AA.ORDR_MTHD_DSC, 
      AA.ORDER_CONSISTENCY,
      AA.NEW_CUST,
      AA.CUST_START,
      AA.LOST,
      AA.MTHS_LOST, 
      AA.LAST_SLS_MTH,
      AA.LAST_CHRN_MTH, 
      AA.LAST_CHRN, 
      AA.FRST_CHRN_MTH, 
      AA.FRST_CHRN,
      AA.CHRN_GAP,
      AA.ROLL_YR_FLAG,
      AA.SALES,
      AA.LOST_ANNUAL_REVENUE,
      AA.CHURN_SALES,
      AA.ACCT_STATUS, 
      (CASE WHEN AA.ACCT_STATUS = 'CUSTOMER' THEN
                (CASE WHEN AA.LOYAL_CNT + AA.NEW_CNT = AA.MTH_CNT THEN 'LOYAL'
                      WHEN AA.ACTIVE_CNT + AA.NEW_CNT = AA.MTH_CNT THEN 'ACTIVE'
                      WHEN AA.LOYAL_CNT + AA.ACTIVE_CNT + AA.NEW_CNT = AA.MTH_CNT THEN 'LOYAL/ACTIVE'
                  ELSE 'AT RISK' END)
            WHEN AA.ACCT_STATUS = 'LOST' THEN
                (CASE WHEN AA.LOYAL_CNT > 0 THEN 'LOST LOYAL'
                      WHEN AA.ACTIVE_CNT > 0 THEN 'LOST ACTIVE'
                 ELSE 'LOST' END)
            WHEN AA.ACCT_STATUS = 'NEW' THEN
                (CASE WHEN AA.LOST_CNT > 0 THEN 'NEW LOST' ELSE 'NEW CUST' END)
            WHEN AA.ACCT_STATUS = 'PREV LOST' THEN 'LOST'
        ELSE 'OTHER' END) AS LIFE_CYCLE,                                        
      AA.MTH_CNT, AA.CHURN_CNT, AA.NEW_CNT, AA.RE_ENGAGE_CNT, AA.CUSTOMER_CNT,
      AA.LOST_CNT, AA.AT_RISK_CNT, AA.RE_ACTIVATED_CNT, AA.LOYAL_CNT, AA.ACTIVE_CNT, 
      AA.NOT_ACTIVE_CNT, AA.CHURN_FLAG, AA.RE_ENGAGE_FLAG, AA.BT_CNT,     
      AA.EVAL_STK_ORD, AA.EVAL_STK_FILL, AA.EVAL_RX_STK_ORD, AA.EVAL_RX_STK_FILL,
      AA.EVAL_LAB_STK_ORD, AA.EVAL_LAB_STK_FILL, AA.EVAL_MEDSRG_STK_ORD, 
      AA.EVAL_MEDSRG_STK_FILL, AA.BSLN_STK_ORD, AA.BSLN_STK_FILL, 
      AA.BSLN_RX_STK_ORD, AA.BSLN_RX_STK_FILL, AA.BSLN_LAB_STK_ORD,
      AA.BSLN_LAB_STK_FILL, AA.BSLN_MEDSRG_STK_ORD, AA.BSLN_MEDSRG_STK_FILL,
      AA.EVAL_RAW_ORD, AA.EVAL_RAW_FILL, AA.EVAL_RX_RAW_ORD, AA.EVAL_RX_RAW_FILL,
      AA.EVAL_LAB_RAW_ORD, AA.EVAL_LAB_RAW_FILL, AA.EVAL_MEDSRG_RAW_ORD, 
      AA.EVAL_MEDSRG_RAW_FILL, AA.BSLN_RAW_ORD, AA.BSLN_RAW_FILL, AA.BSLN_RX_RAW_ORD,
      AA.BSLN_RX_RAW_FILL, AA.BSLN_LAB_RAW_ORD, AA.BSLN_LAB_RAW_FILL,
      AA.BSLN_MEDSRG_RAW_ORD, AA.BSLN_MEDSRG_RAW_FILL,
      AA.EVAL_CREDIT_LINES, AA.EVAL_PRODUCT_ERROR, AA.EVAL_TRANS_ERROR, 
      AA.EVAL_PRICE_ERROR, AA.EVAL_CUSTOMER_ERROR, AA.EVAL_OTHER_ERROR,
      AA.EVAL_LINES_SHIPPED, AA.EVAL_ORDERS_SHIPPED, AA.BSLN_CREDIT_LINES, 
      AA.BSLN_PRODUCT_ERROR, AA.BSLN_TRANS_ERROR, AA.BSLN_PRICE_ERROR,
      AA.BSLN_CUSTOMER_ERROR, AA.BSLN_OTHER_ERROR, AA.BSLN_LINES_SHIPPED, AA.BSLN_ORDERS_SHIPPED,
      AA.UPDATE_DT
FROM (
SELECT 
      ZZ.BILL_TO_CUST_E1_NUM, ZZ.CUST_E1_NUM, ZZ.LGCY_PLTFRM, ZZ.SYS_PLTFRM, ZZ.BUS_PLTFRM, --ZZ.FC_FLAG, 
      ZZ.CNVRSN_TYPE_CD, ZZ.CNVRSN_TYPE_DSC, ZZ.TIER_CD, ZZ.TIER_DSC,
      ZZ.PLATFORM, ZZ.MARKET, ZZ.PLAN_MKT_CD, ZZ.SPCLTY_DSC,
      ZZ.ROLL_YR_ACCT_STATUS, ZZ.ROLL_YR_END_LIFECYCLE,-- ZZ.ORDR_SRC_DSC, ZZ.ORDR_MTHD_DSC,
      ZZ.ORDER_CONSISTENCY, ZZ.NEW_CUST, ZZ.CUST_START, ZZ.LOST, ZZ.MTHS_LOST, ZZ.LAST_SLS_MTH,
      ZZ.LAST_CHRN_MTH, ZZ.LAST_CHRN, ZZ.FRST_CHRN_MTH, ZZ.FRST_CHRN, ZZ.CHRN_GAP,
      ZZ.ROLL_YR_FLAG,
      ZZ.SALES,
      ZZ.LOST_ANNUAL_REVENUE,
      ZZ.CHURN_SALES,
      (CASE WHEN ZZ.NEW_CNT > 0 THEN 'NEW'
            WHEN ZZ.CHURN_CNT > 0 THEN 'LOST'
            WHEN ZZ.CHURN_CNT = 0 AND (ZZ.CUSTOMER_CNT > 0 OR RE_ENGAGE_CNT > 0) THEN 'CUSTOMER'
            WHEN ZZ.CHURN_CNT = 0 AND ZZ.CUSTOMER_CNT > 0 THEN 'CUSTOMER'
            WHEN ZZ.CHURN_CNT = 0 AND ZZ.LOST_CNT = ZZ.MTH_CNT THEN 'PREV LOST'
      ELSE 'OTHER' END) AS ACCT_STATUS,      
      ZZ.MTH_CNT, ZZ.CHURN_CNT, ZZ.NEW_CNT, ZZ.RE_ENGAGE_CNT, ZZ.CUSTOMER_CNT, ZZ.LOST_CNT, 
      ZZ.AT_RISK_CNT, ZZ.RE_ACTIVATED_CNT, ZZ.LOYAL_CNT, ZZ.ACTIVE_CNT, ZZ.NOT_ACTIVE_CNT, ZZ.CHURN_FLAG, ZZ.RE_ENGAGE_FLAG, ZZ.BT_CNT,
      ZZ.EVAL_STK_ORD, ZZ.EVAL_STK_FILL, ZZ.EVAL_RX_STK_ORD, ZZ.EVAL_RX_STK_FILL,
      ZZ.EVAL_LAB_STK_ORD, ZZ.EVAL_LAB_STK_FILL, ZZ.EVAL_MEDSRG_STK_ORD, 
      ZZ.EVAL_MEDSRG_STK_FILL, ZZ.BSLN_STK_ORD, ZZ.BSLN_STK_FILL, 
      ZZ.BSLN_RX_STK_ORD, ZZ.BSLN_RX_STK_FILL, ZZ.BSLN_LAB_STK_ORD,
      ZZ.BSLN_LAB_STK_FILL, ZZ.BSLN_MEDSRG_STK_ORD, ZZ.BSLN_MEDSRG_STK_FILL,
      ZZ.EVAL_RAW_ORD, ZZ.EVAL_RAW_FILL, ZZ.EVAL_RX_RAW_ORD, ZZ.EVAL_RX_RAW_FILL,
      ZZ.EVAL_LAB_RAW_ORD, ZZ.EVAL_LAB_RAW_FILL, ZZ.EVAL_MEDSRG_RAW_ORD, 
      ZZ.EVAL_MEDSRG_RAW_FILL, ZZ.BSLN_RAW_ORD, ZZ.BSLN_RAW_FILL, ZZ.BSLN_RX_RAW_ORD,
      ZZ.BSLN_RX_RAW_FILL, ZZ.BSLN_LAB_RAW_ORD, ZZ.BSLN_LAB_RAW_FILL,
      ZZ.BSLN_MEDSRG_RAW_ORD, ZZ.BSLN_MEDSRG_RAW_FILL,
      ZZ.EVAL_CREDIT_LINES, ZZ.EVAL_PRODUCT_ERROR, ZZ.EVAL_TRANS_ERROR, 
      ZZ.EVAL_PRICE_ERROR, ZZ.EVAL_CUSTOMER_ERROR, ZZ.EVAL_OTHER_ERROR,
      ZZ.EVAL_LINES_SHIPPED, ZZ.EVAL_ORDERS_SHIPPED, ZZ.BSLN_CREDIT_LINES, 
      ZZ.BSLN_PRODUCT_ERROR, ZZ.BSLN_TRANS_ERROR, ZZ.BSLN_PRICE_ERROR,
      ZZ.BSLN_CUSTOMER_ERROR, ZZ.BSLN_OTHER_ERROR, ZZ.BSLN_LINES_SHIPPED, ZZ.BSLN_ORDERS_SHIPPED,
      ZZ.UPDATE_DT
FROM(      
SELECT
      CI.BILL_TO_CUST_E1_NUM, CI.CUST_E1_NUM, CI.LGCY_PLTFRM, CI.SYS_PLTFRM, CI.BUS_PLTFRM, 
   --   (CASE WHEN FC.BILL_TO IS NOT NULL THEN 'FC' ELSE 'MMS' END) AS FC_FLAG, 
      CNVRSN.CNVRSN_TYPE_CD, CNVRSN.CNVRSN_TYPE_DSC, EC_TIER.TIER_CD, EC_TIER.TIER_DSC,
      MKT.PLATFORM, MKT.MARKET, MKT.PLAN_MKT_CD, SPCLTY.SPCLTY_DSC,
      CAS.ROLL_YR_ACCT_STATUS, CAS.ROLL_YR_END_LIFECYCLE,-- CAS.ORDR_SRC_DSC, CAS.ORDR_MTHD_DSC,
      CCBC.ORDER_CONSISTENCY,
         (CASE WHEN CCBC.FIRST_SALE_MTH_RNK <13 THEN '1-12 Mths'
               WHEN CCBC.FIRST_SALE_MTH_RNK <25 THEN '13-24 Mths'
          ELSE '24+ Mths' END) AS NEW_CUST, 
      CCBC.FIRST_SALE_MTH_RNK AS CUST_START,  
         (CASE WHEN CCBC.CHURN_MTH_RNK IS NULL THEN 'Not Lost'
               WHEN CAS.ROLL_YR_END_LIFECYCLE = 'AT RISK' THEN 'Not Lost'
               WHEN CCBC.CHURN_MTH_RNK <13 THEN '1-12 Mths Lost'
               WHEN CCBC.CHURN_MTH_RNK <25 THEN '13-24 Mths Lost'
          ELSE '24+ Mths Lost' END) AS LOST,     
      CCBC.CHURN_MTH_RNK AS MTHS_LOST,  
      LAST_CHRN.LAST_CHRN_MTH,
      LAST_CHRN.LAST_CHRN,
      FRST_CHRN.FRST_CHRN_MTH,
      FRST_CHRN.FRST_CHRN,
      FRST_CHRN.FRST_CHRN-LAST_CHRN.LAST_CHRN AS CHRN_GAP,
      PFT.ROLL_YR_FLAG,
      MIN(CS.MTH_RNK) AS LAST_SLS_MTH,
      round(SUM(CS.EXT_NET_SLS_PROD_SRVC_AMT),2) AS SALES,
      round(SUM(CI.CHURN_SALES),2) AS CHURN_SALES,
    (CASE WHEN CAS.ROLL_YR_END_STATUS = 'LOST' THEN CCBC.LOST_ANNUAL_REVENUE ELSE NULL END) AS LOST_ANNUAL_REVENUE,   
      COUNT(DISTINCT CI.MONTH_RUN) AS MTH_CNT, 
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'LOST' AND CI.CHURN_MONTH = CI.MONTH_RUN THEN CI.MONTH_RUN ELSE NULL END) AS CHURN_CNT,
      COUNT(DISTINCT CASE WHEN CI.MONTH_RUN = CI.FIRST_SALE_MTH THEN CI.MONTH_RUN ELSE NULL END) AS NEW_CNT,
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'RE-ENGAGED' THEN CI.MONTH_RUN ELSE NULL END) AS RE_ENGAGE_CNT,
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'CUSTOMER' THEN CI.MONTH_RUN ELSE NULL END) AS CUSTOMER_CNT,
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'LOST' THEN CI.MONTH_RUN ELSE NULL END) AS LOST_CNT,   
      COUNT(DISTINCT CASE WHEN CI.LIFECYCLE_FLAG = 'AT RISK' THEN CI.MONTH_RUN ELSE NULL END) AS AT_RISK_CNT,
      COUNT(DISTINCT CASE WHEN CI.LIFECYCLE_FLAG = 'RE-ACTIVATED' THEN CI.MONTH_RUN ELSE NULL END) AS RE_ACTIVATED_CNT,
      COUNT(DISTINCT CASE WHEN CI.LIFECYCLE_FLAG = 'LOYAL' THEN CI.MONTH_RUN ELSE NULL END) AS LOYAL_CNT,
      COUNT(DISTINCT CASE WHEN CI.LIFECYCLE_FLAG = 'ACTIVE' THEN CI.MONTH_RUN ELSE NULL END) AS ACTIVE_CNT,        
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'NOT ACTIVE' THEN CI.MONTH_RUN ELSE NULL END) AS NOT_ACTIVE_CNT,      
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'LOST' AND CI.CHURN_MONTH = CI.MONTH_RUN THEN CI.BILL_TO_CUST_E1_NUM ELSE NULL END) AS CHURN_FLAG,
      COUNT(DISTINCT CASE WHEN CI.CHURN_FLAG = 'RE-ENGAGED' THEN CI.BILL_TO_CUST_E1_NUM ELSE NULL END) AS RE_ENGAGE_FLAG,
      COUNT(DISTINCT CI.BILL_TO_CUST_E1_NUM) AS BT_CNT,      
      CFRS.EVAL_STK_ORD, CFRS.EVAL_STK_FILL, CFRS.EVAL_RX_STK_ORD, CFRS.EVAL_RX_STK_FILL,
      CFRS.EVAL_LAB_STK_ORD, CFRS.EVAL_LAB_STK_FILL, CFRS.EVAL_MEDSRG_STK_ORD, 
      CFRS.EVAL_MEDSRG_STK_FILL, CFRS.BSLN_STK_ORD, CFRS.BSLN_STK_FILL, 
      CFRS.BSLN_RX_STK_ORD, CFRS.BSLN_RX_STK_FILL, CFRS.BSLN_LAB_STK_ORD,
      CFRS.BSLN_LAB_STK_FILL, CFRS.BSLN_MEDSRG_STK_ORD, CFRS.BSLN_MEDSRG_STK_FILL,
      CFRS.EVAL_RAW_ORD, CFRS.EVAL_RAW_FILL, CFRS.EVAL_RX_RAW_ORD, CFRS.EVAL_RX_RAW_FILL,
      CFRS.EVAL_LAB_RAW_ORD, CFRS.EVAL_LAB_RAW_FILL, CFRS.EVAL_MEDSRG_RAW_ORD, 
      CFRS.EVAL_MEDSRG_RAW_FILL, CFRS.BSLN_RAW_ORD, CFRS.BSLN_RAW_FILL, CFRS.BSLN_RX_RAW_ORD,
      CFRS.BSLN_RX_RAW_FILL, CFRS.BSLN_LAB_RAW_ORD, CFRS.BSLN_LAB_RAW_FILL,
      CFRS.BSLN_MEDSRG_RAW_ORD, CFRS.BSLN_MEDSRG_RAW_FILL,
      CCS.EVAL_CREDIT_LINES, CCS.EVAL_PRODUCT_ERROR, CCS.EVAL_TRANS_ERROR, 
      CCS.EVAL_PRICE_ERROR, CCS.EVAL_CUSTOMER_ERROR, CCS.EVAL_OTHER_ERROR,
      CCS.EVAL_LINES_SHIPPED, CCS.EVAL_ORDERS_SHIPPED, CCS.BSLN_CREDIT_LINES, 
      CCS.BSLN_PRODUCT_ERROR, CCS.BSLN_TRANS_ERROR, CCS.BSLN_PRICE_ERROR,
      CCS.BSLN_CUSTOMER_ERROR, CCS.BSLN_OTHER_ERROR, CCS.BSLN_LINES_SHIPPED, CCS.BSLN_ORDERS_SHIPPED,
      CCBC.UPDATE_DT
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CUST_CHURN_INDICATOR_ST_CW CI
LEFT JOIN DEV_PL_MMS_EDW_DB.EDWRPT.V_DIM_PERIOD_MTH PFT
 ON CI.MONTH_RUN = PFT.FISC_YR_MTH_NUM
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_SALES_ST_CW CS
 ON CI.BILL_TO_CUST_E1_NUM = CS.BILL_TO_CUST_E1_NUM
 AND CI.CUST_E1_NUM = CS.CUST_E1_NUM
 AND CI.BUS_PLTFRM = CS.BUS_PLTFRM
 AND CI.MONTH_RUN = CS.FISC_YR_MTH_NUM
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_ST_ACCT_STATUS_CW CAS
 ON CI.BILL_TO_CUST_E1_NUM = CAS.BILL_TO_CUST_E1_NUM
 AND CI.CUST_E1_NUM = CAS.CUST_E1_NUM
 AND CI.BUS_PLTFRM = CAS.BUS_PLTFRM
 AND CAS.FISC_YR_NUM = PFT.FISC_YR_NUM
 AND CAS.ROLL_YR_FLAG = PFT.ROLL_YR_FLAG
 AND CAS.FYTD_FLAG = PFT.FYTD_FLAG
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CUST_CHURN_ST_CONSIST_CW CCBC
 ON CI.BILL_TO_CUST_E1_NUM = CCBC.BILL_TO_CUST_E1_NUM
 AND CI.CUST_E1_NUM = CCBC.CUST_E1_NUM
 AND CI.BUS_PLTFRM = CCBC.BUS_PLTFRM
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_ST_FILL_RATE_SUMMARY CFRS
 ON CCBC.BILL_TO_CUST_E1_NUM = CFRS.BILL_TO_CUST_E1_NUM
 AND CCBC.CUST_E1_NUM = CFRS.CUST_E1_NUM
 AND CCBC.BUS_PLTFRM = CFRS.BUS_PLTFRM
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_ST_CREDIT_SUMMARY CCS
 ON CCBC.BILL_TO_CUST_E1_NUM = CCS.BILL_TO_CUST_E1_NUM
 AND CCBC.CUST_E1_NUM = CCS.CUST_E1_NUM
 AND CCBC.BUS_PLTFRM = CCS.BUS_PLTFRM 
LEFT JOIN (
----FIRST CHURN---
SELECT 
BT.BILL_TO_CUST_E1_NUM, BT.CUST_E1_NUM, BT.LGCY_PLTFRM, BT.SYS_PLTFRM, BT.BUS_PLTFRM, 
MAX(BT.MTH_RNK) AS FRST_CHRN,
MIN(BT.MONTH_RUN) AS FRST_CHRN_MTH
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CUST_CHURN_INDICATOR_ST_CW BT
WHERE BT.CHURN_MONTH = BT.MONTH_RUN
AND BT.CHURN_FLAG = 'LOST'
AND BT.MONTH_RUN > 201712
GROUP BY
BT.BILL_TO_CUST_E1_NUM, BT.CUST_E1_NUM, BT.LGCY_PLTFRM, BT.SYS_PLTFRM, BT.BUS_PLTFRM
)FRST_CHRN
ON CCBC.BILL_TO_CUST_E1_NUM = FRST_CHRN.BILL_TO_CUST_E1_NUM
AND CCBC.CUST_E1_NUM = FRST_CHRN.CUST_E1_NUM
AND CCBC.BUS_PLTFRM = FRST_CHRN.BUS_PLTFRM
LEFT JOIN (
----LAST CHURN---
SELECT 
BT.BILL_TO_CUST_E1_NUM, BT.CUST_E1_NUM, BT.LGCY_PLTFRM, BT.SYS_PLTFRM, BT.BUS_PLTFRM, 
MIN(BT.MTH_RNK) AS LAST_CHRN,
MAX(BT.MONTH_RUN) AS LAST_CHRN_MTH
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CUST_CHURN_INDICATOR_ST_CW BT
WHERE BT.CHURN_MONTH = BT.MONTH_RUN
AND BT.CHURN_FLAG = 'LOST'
AND BT.MONTH_RUN > 201712
GROUP BY
BT.BILL_TO_CUST_E1_NUM, BT.CUST_E1_NUM, BT.LGCY_PLTFRM, BT.SYS_PLTFRM, BT.BUS_PLTFRM
)LAST_CHRN
ON CCBC.BILL_TO_CUST_E1_NUM = LAST_CHRN.BILL_TO_CUST_E1_NUM
AND CCBC.CUST_E1_NUM = LAST_CHRN.CUST_E1_NUM
AND CCBC.BUS_PLTFRM = LAST_CHRN.BUS_PLTFRM 
LEFT JOIN (
SELECT
TIE.*
FROM(
SELECT DISTINCT 
CNVSRN_RNK.BILL_TO_CUST_E1_NUM, CNVSRN_RNK.CUST_E1_NUM, CNVSRN_RNK.BUS_PLTFRM, CNVSRN_RNK.CNVRSN_TYPE_CD, CNVSRN_RNK.CNVRSN_TYPE_DSC,CNVSRN_RNK.TIE,
DENSE_RANK() OVER (PARTITION BY BILL_TO_CUST_E1_NUM, CUST_E1_NUM, BUS_PLTFRM ORDER BY TIE, CNVRSN_TYPE_CD) AS RNK
FROM(
SELECT DISTINCT 
CB.BILL_TO_CUST_E1_NUM, CB.CUST_E1_NUM, CB.BUS_PLTFRM, CB.CNVRSN_TYPE_CD, CB.CNVRSN_TYPE_DSC,
(CASE WHEN CB.CNVRSN_TYPE_CD = 'E' THEN 1 ELSE 0 END) AS TIE
FROM DEV_PL_MMS_EDW_DB.EDWRPT.V_DIM_CUST_E1_BLEND_CURR CB
WHERE CB.CNVRSN_TYPE_CD <> 'N/A'
--AND BILL_TO_CUST_E1_NUM = 61771714
)CNVSRN_RNK
)TIE
WHERE TIE.RNK = 1
) CNVRSN
ON CI.BILL_TO_CUST_E1_NUM = CNVRSN.BILL_TO_CUST_E1_NUM
AND CI.CUST_E1_NUM = CNVRSN.CUST_E1_NUM
AND CI.BUS_PLTFRM = CNVRSN.BUS_PLTFRM
LEFT JOIN (
SELECT
AA.*
FROM (
SELECT
    RNK.*,
    ROW_NUMBER() OVER (PARTITION BY RNK.BILL_TO_CUST_E1_NUM, RNK.CUST_E1_NUM, RNK.BUS_PLTFRM ORDER BY RNK.SALES DESC, RNK.ST_CNT DESC, RNK.ORDERS DESC, RNK.SELL_GP DESC) AS RNK
FROM (
SELECT
    CS.BILL_TO_CUST_E1_NUM, CS.CUST_E1_NUM, CS.BUS_PLTFRM, 
    CS.PLATFORM, CS.MARKET, CS.DIV_CD, CS.PLAN_MKT_CD, 
    COUNT(DISTINCT CS.CUST_E1_NUM) AS ST_CNT,
    SUM(CS.EXT_NET_SLS_PROD_SRVC_AMT) AS SALES,
    SUM(CS.EXT_SELL_GP_PROD_SRVC_AMT) AS SELL_GP,
    SUM(CS.SALES_ORDERS) AS ORDERS
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_SALES_ST_CW CS
GROUP BY
    CS.BILL_TO_CUST_E1_NUM, CS.CUST_E1_NUM, CS.BUS_PLTFRM, 
    CS.PLATFORM, CS.MARKET, CS.DIV_CD, CS.PLAN_MKT_CD
)RNK
)AA
WHERE AA.RNK = 1
)MKT
ON CI.BILL_TO_CUST_E1_NUM = MKT.BILL_TO_CUST_E1_NUM
AND CI.CUST_E1_NUM = MKT.CUST_E1_NUM
AND CI.BUS_PLTFRM = MKT.BUS_PLTFRM
LEFT JOIN (
SELECT 
SP.*
FROM(
SELECT 
RNK.BILL_TO_CUST_E1_NUM, RNK.CUST_E1_NUM, RNK.BUS_PLTFRM, RNK.SPCLTY_DSC, RNK.SALES,
ROW_NUMBER() OVER (PARTITION BY RNK.BILL_TO_CUST_E1_NUM, RNK.CUST_E1_NUM, RNK.BUS_PLTFRM ORDER BY RNK.SALES DESC) AS SPCLTY_RNK
FROM(
SELECT  
ST.BILL_TO_CUST_E1_NUM, ST.CUST_E1_NUM, ST.BUS_PLTFRM, ST.SPCLTY_DSC,
SUM(CS.EXT_NET_SLS_PROD_SRVC_AMT) AS SALES
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CUST_CHURN_INDICATOR_ST_CW ST
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.M_CHURN_SALES_ST_CW CS
 ON ST.CUST_E1_NUM = CS.CUST_E1_NUM
 AND ST.MONTH_RUN = CS.FISC_YR_MTH_NUM
GROUP BY
ST.BILL_TO_CUST_E1_NUM, ST.CUST_E1_NUM, ST.BUS_PLTFRM, ST.SPCLTY_DSC
)RNK
)SP
WHERE SP.SPCLTY_RNK = 1
)SPCLTY
ON CI.BILL_TO_CUST_E1_NUM = SPCLTY.BILL_TO_CUST_E1_NUM
AND CI.CUST_E1_NUM = SPCLTY.CUST_E1_NUM
AND CI.BUS_PLTFRM = SPCLTY.BUS_PLTFRM
LEFT JOIN (
SELECT DISTINCT 
    TIER_RNK.BILL_TO_CUST_NUM, TIER_RNK.CUST_E1_NUM, TIER_RNK.BUS_PLTFRM, TIER_RNK.TIER_CD, TIER_RNK.TIER_DSC, TIER_RNK.RNK,TIER_RNK.T_RNK
FROM(
SELECT DISTINCT 
    T_RNK.BILL_TO_CUST_NUM, T_RNK.CUST_E1_NUM, T_RNK.BUS_PLTFRM, T_RNK.TIER_CD, T_RNK.TIER_DSC, T_RNK.RNK,
    ROW_NUMBER() OVER (PARTITION BY T_RNK.BILL_TO_CUST_NUM, T_RNK.CUST_E1_NUM, T_RNK.BUS_PLTFRM ORDER BY T_RNK.RNK) AS T_RNK
FROM(
SELECT DISTINCT
  CC.BILL_TO_CUST_NUM,
  CC.CUST_E1_NUM,
  CC.BUS_PLTFRM,
  CC.TIER_CD, CC.TIER_DSC,
(CASE WHEN CC.TIER_CD = 'T1' THEN 1
      WHEN CC.TIER_CD = 'T2' THEN 2
      WHEN CC.TIER_CD = 'T3' THEN 3
      WHEN CC.TIER_CD = 'T4' THEN 4
      WHEN CC.TIER_CD = 'GS4' THEN 5
      WHEN CC.TIER_CD = 'GS3' THEN 6
      WHEN CC.TIER_CD = 'GS2' THEN 7
      WHEN CC.TIER_CD = 'GS1' THEN 8       
ELSE 9 END) AS RNK
FROM DEV_PL_MMS_EDW_DB.EDWRPT.V_DIM_CUST_CURR CC
--WHERE CC.TIER_CD <> 'N/A'
)T_RNK
)TIER_RNK
