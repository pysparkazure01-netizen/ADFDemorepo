-- Check overlap of DIM_CUST_CURR_ID between both tables
SELECT
    COUNT(DISTINCT CB.DIM_CUST_CURR_ID)  AS BLEND_CURR_IDS,
    COUNT(DISTINCT SR.DIM_CUST_CURR_ID)  AS NEW_VIEW_IDS,
    COUNT(DISTINCT 
        CASE WHEN SR.DIM_CUST_CURR_ID IS NOT NULL 
        THEN CB.DIM_CUST_CURR_ID END)    AS MATCHING_IDS,
    COUNT(DISTINCT 
        CASE WHEN SR.DIM_CUST_CURR_ID IS NULL 
        THEN CB.DIM_CUST_CURR_ID END)    AS NON_MATCHING_IDS
FROM DEV_ENT_DL_US_MMS_MISC_DB.HADOOP.V_DIM_CUST_E1_BLEND_CURR CB
LEFT JOIN DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT SR
    ON CB.DIM_CUST_CURR_ID = SR.DIM_CUST_CURR_ID;
