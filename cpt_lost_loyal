SELECT 
    CUST_E1_NUM,
    COUNT(DISTINCT CASE WHEN LIFECYCLE_FLAG = 'LOYAL' THEN MONTH_RUN END) AS LOYAL_CNT,
    COUNT(DISTINCT CASE WHEN LIFECYCLE_FLAG = 'LOST' THEN MONTH_RUN END) AS LOST_CNT
FROM M_CUST_CHURN_INDICATOR_ST_CW
GROUP BY CUST_E1_NUM
HAVING LOYAL_CNT > 0 AND LOST_CNT > 0
LIMIT 100;
