SELECT 
    SR.MAPS_MKT,
    SR.MAPS_STNG,
    SR.MAPS_TYPE,
    LYL.CUST_SGMNT_MKT_DSC,
    LYL.CUST_SGMNT_SETTNG_DSC,
    LYL.CUST_SGMNT_DFLT_TYPE_DSC,
    LYL.LOYAL_CTGRY_LIMIT,
    COUNT(*) AS CUST_COUNT
FROM DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT SR
LEFT JOIN CHURN_SITE_LOYAL_CTGRY_CW LYL
    ON UPPER(SR.MAPS_MKT)  = UPPER(LYL.CUST_SGMNT_MKT_DSC)
    AND UPPER(SR.MAPS_STNG) = UPPER(LYL.CUST_SGMNT_SETTNG_DSC)
    AND UPPER(SR.MAPS_TYPE) = UPPER(LYL.CUST_SGMNT_DFLT_TYPE_DSC)
GROUP BY 1,2,3,4,5,6,7
ORDER BY LYL.LOYAL_CTGRY_LIMIT NULLS FIRST;
