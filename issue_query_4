-- See what MAPS values exist in the view
SELECT DISTINCT 
    MAPS_MKT,
    MAPS_STNG,
    MAPS_TYPE,
    COUNT(*) AS CUST_COUNT
FROM DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT
GROUP BY 1,2,3
ORDER BY CUST_COUNT DESC
LIMIT 50;


-- See what values exist in the lookup table
SELECT DISTINCT
    CUST_SGMNT_MKT_DSC,
    CUST_SGMNT_SETTNG_DSC,
    CUST_SGMNT_DFLT_TYPE_DSC,
    LOYAL_CTGRY_LIMIT
FROM CHURN_SITE_LOYAL_CTGRY_CW
ORDER BY 1,2,3;
