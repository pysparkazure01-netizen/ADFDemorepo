SELECT 
    COUNT(*) AS TOTAL_CUSTS,
    SUM(CASE WHEN MAPS_MKT IS NULL THEN 1 ELSE 0 END) AS NULL_MKT,
    SUM(CASE WHEN MAPS_STNG IS NULL THEN 1 ELSE 0 END) AS NULL_STNG,
    SUM(CASE WHEN MAPS_TYPE IS NULL THEN 1 ELSE 0 END) AS NULL_TYPE,
    SUM(CASE WHEN MAPS_MKT IS NULL 
         AND MAPS_STNG IS NULL 
         AND MAPS_TYPE IS NULL THEN 1 ELSE 0 END) AS ALL_THREE_NULL
FROM DEV_ENT_DL_US_MMS_MISC_DB.MMSDW.V_MDM_CUST_SEGMENT;
